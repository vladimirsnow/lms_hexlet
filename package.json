{
  "name": "kzhexly-college-lms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run prisma:generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/lib/**/*.ts\" \"src/components/**/*.tsx\" \"src/app/api/**/*.ts\" \"src/app/{error,loading,not-found}.tsx\" \"scripts/**/*.mjs\" \"*.{json,mjs,ts}\" \".github/**/*.yml\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:dependency-compat": "node scripts/check-minimatch-compat.mjs",
    "postinstall": "patch-package",
    "worker": "node scripts/worker.mjs",
    "mail:verify": "node scripts/verify-smtp.mjs",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:academic-demo": "tsx scripts/seed-academic-demo.ts",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 start",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 stop",
    "db:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 status",
    "storage:local:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-minio-build.ps1",
    "storage:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-minio.ps1 start",
    "storage:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-minio.ps1 stop",
    "storage:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-minio.ps1 status",
    "backup:local:restore-check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-backup-restore-check.ps1",
    "storage:rustfs:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-object-store.ps1 start",
    "storage:rustfs:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-object-store.ps1 stop",
    "storage:rustfs:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-object-store.ps1 status",
    "storage:local:provision": "tsx scripts/local-object-store-provision.mjs",
    "clamav:local:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-clamav.ps1 update",
    "clamav:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-clamav.ps1 start",
    "clamav:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-clamav.ps1 stop",
    "clamav:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-clamav.ps1 status",
    "e2e:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-e2e.ps1",
    "accounts:bootstrap": "tsx scripts/bootstrap-accounts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@better-auth/prisma-adapter": "^1.7.14",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "better-auth": "^1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "isomorphic-dompurify": "3.4.0",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "minimatch": "11.0.1",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
