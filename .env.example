# Local development only. Copy to .env and replace every value.
APP_URL=http://127.0.0.1:3000
APP_DOMAIN=localhost
NODE_ENV=development
TZ=Asia/Almaty
# Set true only for the approved public HTTPS production domain.
SEO_INDEXING_ENABLED=false

POSTGRES_DB=lms_dev
POSTGRES_USER=lms_dev
POSTGRES_PASSWORD=replace-with-a-long-local-only-password
LOCAL_POSTGRES_PORT=5433
DATABASE_URL=postgresql://lms_dev:replace-with-a-long-local-only-password@localhost:5433/lms_dev
# Prisma CLI migrations use DIRECT_URL when set; for local PostgreSQL it matches DATABASE_URL.
DIRECT_URL=postgresql://lms_dev:replace-with-a-long-local-only-password@localhost:5433/lms_dev

MINIO_ROOT_USER=minio_root_local
MINIO_ROOT_PASSWORD=replace-with-another-long-local-only-password
MINIO_ACCESS_KEY=lms_app_local
MINIO_SECRET_KEY=replace-with-a-different-long-local-only-password
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=lms-private
MINIO_USE_SSL=false
S3_REGION=us-east-1
STORAGE_UPLOAD_MODE=post
DATABASE_POOL_MAX=5
MINIO_API_CORS_ALLOW_ORIGIN=http://127.0.0.1:3000,http://localhost:3000,https://localhost
LOCAL_OBJECT_STORAGE_PROVIDER=minio-community
LOCAL_OBJECT_STORE_DATA_DIR=
LOCAL_MINIO_DATA_DIR=

AUTH_SECRET=replace-with-at-least-32-random-bytes-for-local-development
UPLOAD_MAX_MB=100
COURSE_QUOTA_GB=5
USER_QUOTA_GB=1
# Local dev skips antivirus; set true in staging/production and configure a scanner.
FILE_SCAN_REQUIRED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_STREAM_MAX=100M
COURSE_LINK_ALLOWED_HOSTS=youtube.com,www.youtube.com,youtu.be,vimeo.com,player.vimeo.com
BACKUP_AGE_RECIPIENT=

# Optional; use only the college SMTP server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=true
